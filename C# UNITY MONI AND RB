// FREE (VECTOR BASED MOVEMENT)
// Attach this to a character GameObject. Good for top- down action game,platforms
// (horizontal axis), twin-stick shooters. Movement is continious, not tile locked.

using Unity
{
	puclic float moveSpeed = 5f

	void Update()
	{
	// GetAxis gives smooth value between -1 and 1 (supports keyboard AND controller)
	float horizontal = Input.GetAxis("horizontal"); // A/D pr Left/Right arrows
	float vertical = Input.GetAxis("vertical"); // W/S or Up/Down arrows

	Vector3 direction = new Vector3(horizontal,vertical, 0f);
	//Normalize so diagonal isnt faster them straight movement
	if direction.Normalize
	{
	direction.Normalize();
	}
	transform.position += direction *moveSpeed*Time.deltatime;
    }
}

